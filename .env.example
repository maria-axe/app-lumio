# Cole aqui sua chave do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opcional: fallback gratuito quando o Gemini estiver sem cota.
# Chave do Groq (https://console.groq.com/keys).
# GROQ_API_KEY=
# Modelos em ordem de preferência (padrão: gpt-oss-120b, gpt-oss-20b).
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Opcional: porta do servidor (padrão: 3000)
# PORT=3000

# Recomendado: segredo para assinar tokens do teste de nivelamento.
# Se vazio, o servidor usa GEMINI_API_KEY ou GROQ_API_KEY como fallback.
# PLACEMENT_SECRET=
