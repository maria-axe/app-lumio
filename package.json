{
  "name": "lumio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "npm run frontend:dev",
    "server:dev": "node --watch server/index.js",
    "build": "npm run frontend:build",
    "preview": "npm run frontend:preview",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm run install:frontend && npm --prefix frontend run build",
    "frontend:preview": "npm --prefix frontend run preview",
    "worker:dev": "wrangler dev",
    "install:frontend": "npm ci --prefix frontend",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
